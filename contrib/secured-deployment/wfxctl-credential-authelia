import base64
import fcntl
import json
import os
from pathlib import Path
import ssl
import sys
import tempfile
import time
from urllib.error import HTTPError
from urllib.parse import urlencode, urlsplit
from urllib.request import Request, urlopen


ROOT = Path(__file__).resolve().parent
ISSUER = os.environ.get("WFX_OAUTH_ISSUER", "https://authelia.localhost:8443").rstrip("/")
CLIENT_ID = "wfxctl"
SCOPES = "openid offline_access groups read:jobs write:jobs"
API_HOST = os.environ.get("WFX_OAUTH_API_HOST", "wfx-mgmt.localhost:8443").lower()
CA_FILE = Path(os.environ.get("WFX_OAUTH_CA", ROOT / "state/certs/ca.pem"))
TOKEN_DIR = Path(os.environ.get("WFX_OAUTH_TOKEN_DIR", ROOT / "state/wfxctl"))
TOKEN_FILE = TOKEN_DIR / "tokens.json"


class OAuthError(Exception):
    pass


def tls_context():
    return ssl.create_default_context(cafile=str(CA_FILE))


def decode_json(body):
    try:
        value = json.loads(body)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise OAuthError("identity provider returned invalid JSON") from error
    if not isinstance(value, dict):
        raise OAuthError("identity provider returned invalid JSON")
    return value


def get_json(url, context):
    request = Request(url, headers={"Accept": "application/json"})
    try:
        with urlopen(request, context=context, timeout=10) as response:
            return decode_json(response.read())
    except HTTPError as error:
        raise OAuthError(f"identity provider returned HTTP {error.code}") from error


def post_form(url, form, context):
    request = Request(
        url,
        data=urlencode(form).encode(),
        headers={
            "Accept": "application/json",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )
    try:
        with urlopen(request, context=context, timeout=10) as response:
            return decode_json(response.read() or b"{}"), response.status
    except HTTPError as error:
        return decode_json(error.read() or b"{}"), error.code


def discover(context):
    metadata = get_json(f"{ISSUER}/.well-known/openid-configuration", context)
    if metadata.get("issuer", "").rstrip("/") != ISSUER:
        raise OAuthError("OIDC discovery issuer does not match configured issuer")
    endpoints = {
        "token_endpoint": metadata.get("token_endpoint"),
        "device_authorization_endpoint": metadata.get("device_authorization_endpoint"),
    }
    if not all(endpoints.values()):
        raise OAuthError("issuer does not advertise device authorization and token endpoints")
    validate_endpoints(endpoints)
    return endpoints


def validate_endpoints(endpoints):
    issuer = urlsplit(ISSUER)
    for endpoint in endpoints.values():
        parsed = urlsplit(endpoint)
        if parsed.scheme != "https" or parsed.netloc.lower() != issuer.netloc.lower():
            raise OAuthError("issuer advertised an unsafe OAuth endpoint")


def oauth_error(payload, status):
    error = payload.get("error_description") or payload.get("error")
    if not error:
        error = f"identity provider returned HTTP {status}"
    return OAuthError(str(error))


def access_token_expiry(token):
    try:
        payload = token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload))
        return int(claims["exp"])
    except (IndexError, ValueError, TypeError, KeyError, json.JSONDecodeError):
        return None


def token_record(payload, endpoints, previous_refresh_token=""):
    access_token = payload.get("access_token")
    refresh_token = payload.get("refresh_token") or previous_refresh_token
    expires_at = access_token_expiry(access_token) if isinstance(access_token, str) else None
    if expires_at is None and isinstance(payload.get("expires_in"), int):
        expires_at = int(time.time()) + payload["expires_in"]
    if not access_token or not refresh_token or expires_at is None:
        raise OAuthError("token response missing access token, refresh token, or expiry")
    return {
        "issuer": ISSUER,
        "client_id": CLIENT_ID,
        "access_token": access_token,
        "refresh_token": refresh_token,
        "expires_at": expires_at,
        **endpoints,
    }


def request_device_token(endpoints, context):
    response, status = post_form(
        endpoints["device_authorization_endpoint"],
        {"client_id": CLIENT_ID, "scope": SCOPES},
        context,
    )
    if status != 200:
        raise oauth_error(response, status)
    try:
        device_code = response["device_code"]
        expires_in = int(response["expires_in"])
        interval = max(1, int(response.get("interval", 5)))
        verification_uri = response.get("verification_uri_complete") or response["verification_uri"]
    except (KeyError, TypeError, ValueError) as error:
        raise OAuthError("device authorization response is incomplete") from error

    user_code = response.get("user_code")
    print(f"Open {verification_uri} to authorize wfxctl.", file=sys.stderr)
    if user_code:
        print(f"User code: {user_code}", file=sys.stderr)

    deadline = time.monotonic() + expires_in
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise OAuthError("device code expired; run login again")
        time.sleep(min(interval, remaining))
        result, status = post_form(
            endpoints["token_endpoint"],
            {
                "client_id": CLIENT_ID,
                "device_code": device_code,
                "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
            },
            context,
        )
        if status == 200 and result.get("access_token"):
            return token_record(result, endpoints)
        error = result.get("error")
        if error == "authorization_pending":
            continue
        if error == "slow_down":
            interval += 5
            continue
        raise oauth_error(result, status)


def prepare_token_dir():
    TOKEN_DIR.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(TOKEN_DIR, 0o700)


def token_lock():
    prepare_token_dir()
    lock_file = TOKEN_FILE.with_suffix(TOKEN_FILE.suffix + ".lock")
    fd = os.open(lock_file, os.O_CREAT | os.O_RDWR, 0o600)
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, "r+")


def load_tokens():
    try:
        tokens = json.loads(TOKEN_FILE.read_text())
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as error:
        raise OAuthError("token cache unreadable; run logout, then login again") from error
    if not isinstance(tokens, dict):
        raise OAuthError("token cache invalid; run logout, then login again")
    return tokens


def save_tokens(tokens):
    prepare_token_dir()
    fd, temporary = tempfile.mkstemp(dir=TOKEN_DIR)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as output:
            json.dump(tokens, output)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, TOKEN_FILE)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def revoke(tokens):
    context = tls_context()
    metadata = get_json(f"{ISSUER}/.well-known/openid-configuration", context)
    endpoint = metadata.get("revocation_endpoint")
    if not endpoint:
        raise OAuthError("issuer does not advertise a revocation endpoint")
    validate_endpoints({"revocation_endpoint": endpoint})
    response, status = post_form(
        endpoint,
        {
            "client_id": CLIENT_ID,
            "token": tokens["refresh_token"],
            "token_type_hint": "refresh_token",
        },
        context,
    )
    if status != 200:
        raise oauth_error(response, status)


def login():
    context = tls_context()
    tokens = request_device_token(discover(context), context)
    with token_lock() as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        save_tokens(tokens)
    print(f"wfxctl login saved token cache at {TOKEN_FILE}", file=sys.stderr)


def bearer_token():
    with token_lock() as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        tokens = load_tokens()
        if not tokens or tokens.get("issuer") != ISSUER or tokens.get("client_id") != CLIENT_ID:
            raise OAuthError("not logged in; run wfxctl-credential-authelia login")
        if not isinstance(tokens.get("access_token"), str) or not isinstance(
            tokens.get("refresh_token"), str
        ):
            raise OAuthError("token cache incomplete; run wfxctl-credential-authelia login")
        expires_at = tokens.get("expires_at", 0)
        if isinstance(expires_at, (int, float)) and expires_at > time.time() + 30:
            return tokens["access_token"]

        context = tls_context()
        endpoints = {
            "token_endpoint": tokens.get("token_endpoint"),
            "device_authorization_endpoint": tokens.get("device_authorization_endpoint"),
        }
        if not endpoints["token_endpoint"]:
            endpoints = discover(context)
        else:
            validate_endpoints(endpoints)
        response, status = post_form(
            endpoints["token_endpoint"],
            {
                "client_id": CLIENT_ID,
                "grant_type": "refresh_token",
                "refresh_token": tokens["refresh_token"],
            },
            context,
        )
        if status != 200:
            error = response.get("error", status)
            hint = "; run login again" if error in {"invalid_grant", "invalid_client"} else ""
            raise OAuthError(f"token refresh failed ({error}){hint}")
        refreshed = token_record(response, endpoints, tokens["refresh_token"])
        save_tokens(refreshed)
        return refreshed["access_token"]


def check_api_target(fields):
    if fields.get("protocol", "").lower() != "https":
        raise OAuthError("refusing to send bearer token over non-HTTPS")
    if fields.get("host", "").lower() != API_HOST:
        raise OAuthError(
            f"refusing to send bearer token to unexpected host {fields.get('host', '')!r}"
        )
    path = fields.get("path", "").strip("/").split("/")
    if path[:3] != ["api", "wfx", "v1"] or ".." in path:
        raise OAuthError("refusing to send bearer token outside the wfx API")


def read_fields(stream):
    fields = {}
    for line in stream:
        line = line.rstrip("\r\n")
        if not line:
            break
        key, separator, value = line.partition("=")
        if not separator:
            raise OAuthError("invalid credential-helper request")
        fields[key] = value
    return fields


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in {"get", "login", "logout"}:
        raise OAuthError("usage: wfxctl-credential-authelia {get|login|logout}")
    action = sys.argv[1]
    if action == "login":
        login()
    elif action == "logout":
        with token_lock() as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                tokens = load_tokens()
                if tokens and isinstance(tokens.get("refresh_token"), str):
                    revoke(tokens)
            except (OAuthError, OSError) as error:
                print(f"warning: refresh token not revoked remotely: {error}", file=sys.stderr)
            TOKEN_FILE.unlink(missing_ok=True)
        print("wfxctl token cache removed", file=sys.stderr)
    else:
        check_api_target(read_fields(sys.stdin))
        token = bearer_token()
        print("authtype=Bearer")
        print(f"credential={token}")
        print()


if __name__ == "__main__":
    try:
        main()
    except (OAuthError, OSError, ssl.SSLError) as error:
        print(f"wfxctl-credential-authelia: {error}", file=sys.stderr)
        sys.exit(1)
